{% doc %}
  @prompt
    Create a premium hero section for the Prestige theme with a video background, optimized for mobile-first.
    
    Goal:
    Deliver a strong visual impact with a clean, luxury feel and clear call to action.
    
    --------------------------------
    CONTENT (Spanish)
    --------------------------------
    Headline:
    Joyería que eleva tu estilo.
    
    Subheadline:
    Diseños atemporales, pensados para acompañarte todos los días.
    
    CTA Primary:
    Comprar ahora
    
    CTA Secondary:
    Ver colecciones
    
    --------------------------------
    MEDIA
    --------------------------------
    - Background video (primary)
    - Fallback image (required)
    
    --------------------------------
    VIDEO BEHAVIOR
    --------------------------------
    - Autoplay (muted)
    - Loop enabled
    - No controls
    - Inline playback
    
    --------------------------------
    MOBILE OPTIMIZATION
    --------------------------------
    - Option to disable video on mobile
    - Use fallback image if needed
    - Keep text always readable
    
    --------------------------------
    LAYOUT
    --------------------------------
    - Full-width
    - Text overlay centered or bottom-aligned
    - Strong hierarchy
    
    --------------------------------
    OVERLAY
    --------------------------------
    - Add dark/gradient overlay
    - Adjustable opacity
    
    --------------------------------
    EDITOR SETTINGS
    --------------------------------
    - Upload video
    - Upload fallback image
    - Toggle video on mobile
    - Adjust overlay opacity
    
    --------------------------------
    RULES
    --------------------------------
    - Keep text minimal
    - Ensure CTA is visible above the fold
    - Prioritize performance
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-video-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.min_height_mobile }}px;
    overflow: hidden;
    display: flex;
    align-items: {{ block.settings.content_alignment_vertical }};
    justify-content: {{ block.settings.content_alignment_horizontal }};
  }

  @media screen and (min-width: 750px) {
    .ai-hero-video-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_desktop }}px;
    }
  }

  .ai-hero-video__media-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-hero-video__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-video__video-{{ ai_gen_id }} {
      {% if block.settings.disable_video_mobile %}
        display: none;
      {% endif %}
    }
  }

  .ai-hero-video__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-video__image-{{ ai_gen_id }} {
      {% if block.settings.video != blank %}
        display: none;
      {% endif %}
    }
  }

  .ai-hero-video__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-video__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-video__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-video__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    {% if block.settings.overlay_style == 'solid' %}
      background-color: {{ block.settings.overlay_color }};
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    {% elsif block.settings.overlay_style == 'gradient_top' %}
      background: linear-gradient(to bottom, {{ block.settings.overlay_color }} 0%, rgba(0,0,0,0) 100%);
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    {% elsif block.settings.overlay_style == 'gradient_bottom' %}
      background: linear-gradient(to top, {{ block.settings.overlay_color }} 0%, rgba(0,0,0,0) 100%);
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    {% endif %}
  }

  .ai-hero-video__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: {{ block.settings.content_max_width }}px;
    padding: 40px 20px;
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (min-width: 750px) {
    .ai-hero-video__content-{{ ai_gen_id }} {
      padding: 60px 40px;
    }
  }

  .ai-hero-video__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: {{ block.settings.heading_letter_spacing }}%;
    text-transform: {{ block.settings.heading_text_transform }};
  }

  @media screen and (min-width: 750px) {
    .ai-hero-video__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
      margin-bottom: 24px;
    }
  }

  .ai-hero-video__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size_mobile }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    letter-spacing: {{ block.settings.subheading_letter_spacing }}%;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-video__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
      margin-bottom: 40px;
    }
  }

  .ai-hero-video__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-hero-video__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: {{ block.settings.button_letter_spacing }}%;
    text-transform: {{ block.settings.button_text_transform }};
    border-radius: {{ block.settings.button_border_radius }}px;
  }

  .ai-hero-video__button--primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_text_color }};
  }

  .ai-hero-video__button--primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_hover_bg }};
    color: {{ block.settings.button_primary_hover_text }};
  }

  .ai-hero-video__button--secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_text_color }};
    border: 2px solid {{ block.settings.button_secondary_border }};
  }

  .ai-hero-video__button--secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_bg }};
    color: {{ block.settings.button_secondary_hover_text }};
    border-color: {{ block.settings.button_secondary_hover_border }};
  }
{% endstyle %}

<premium-hero-{{ ai_gen_id }} class="ai-hero-video-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-video__media-{{ ai_gen_id }}">
    {% if block.settings.video != blank %}
      <video
        class="ai-hero-video__video-{{ ai_gen_id }}"
        autoplay
        muted
        loop
        playsinline
        {% if block.settings.fallback_image != blank %}
          poster="{{ block.settings.fallback_image | image_url: width: 2000 }}" {% elsif block.settings.video.preview_image != blank %} poster="{{ block.settings.video.preview_image | image_url: width: 1080 }}"
        {% endif %}
      >
        {% for source in block.settings.video.sources %}{% if source.format == 'mp4' %}<source src="{{ source.url | replace: 'HD-1080p-2.5Mbps', 'SD-480p-0.9Mbps' }}" type="{{ source.mime_type }}" media="(max-width: 749px)">{% endif %}{% endfor %}{% for source in block.settings.video.sources %}
          <source src="{{ source.url }}" type="{{ source.mime_type }}"{% if source.format == 'mp4' %} media="(min-width: 750px)"{% endif %}>
        {% endfor %}
      </video>
    {% endif %}

    {% if block.settings.fallback_image != blank %}
      <img
        src="{{ block.settings.fallback_image | image_url: width: 2000 }}"
        alt="{{ block.settings.fallback_image.alt | escape }}"
        loading="eager"
        width="{{ block.settings.fallback_image.width }}"
        height="{{ block.settings.fallback_image.height }}"
        class="ai-hero-video__image-{{ ai_gen_id }}"
      >
    {% elsif block.settings.video == blank %}
      <div class="ai-hero-video__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        {% if request.design_mode %}<div class="ai-hero-video__empty-state-{{ ai_gen_id }}">
          Agrega un video o imagen de fondo
        </div>{% endif %}
      </div>
    {% endif %}
  </div>

  {% if block.settings.overlay_style != 'none' %}
    <div class="ai-hero-video__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-hero-video__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-hero-video__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-hero-video__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
    {% endif %}

    {% if block.settings.button_primary_label != blank or block.settings.button_secondary_label != blank %}
      <div class="ai-hero-video__buttons-{{ ai_gen_id }}">
        {% if block.settings.button_primary_label != blank %}
          <a
            href="{{ block.settings.button_primary_link }}"
            class="ai-hero-video__button-{{ ai_gen_id }} ai-hero-video__button--primary-{{ ai_gen_id }}"
          >
            {{ block.settings.button_primary_label }}
          </a>
        {% endif %}

        {% if block.settings.button_secondary_label != blank %}
          <a
            href="{{ block.settings.button_secondary_link }}"
            class="ai-hero-video__button-{{ ai_gen_id }} ai-hero-video__button--secondary-{{ ai_gen_id }}"
          >
            {{ block.settings.button_secondary_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</premium-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.video = this.querySelector('.ai-hero-video__video-{{ ai_gen_id }}');
      }

      connectedCallback() {
        if (this.video) {
          this.video.addEventListener('loadedmetadata', () => {
            this.video.play().catch(() => {});
          });

          if (this.video.readyState >= 2) {
            this.video.play().catch(() => {});
          }
        }
      }
    }

    customElements.define('premium-hero-{{ ai_gen_id }}', PremiumHero{{ ai_gen_id }});
  })();
</script>

