          "settings": {
            "liquid": "{% assign faq_metafield = product.metafields['imperialjewelry']['preguntas'] %}\n\n{% if faq_metafield != blank %}\n  <div id=\"faq-block\">\n    <button id=\"faq-toggle\" aria-expanded=\"false\" aria-controls=\"faq-content\">\n      Dudas del producto\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n        <polyline points=\"6 9 12 15 18 9\"></polyline>\n      </svg>\n    </button>\n\n    <div id=\"faq-content\" hidden>\n      {{ faq_metafield | metafield_tag }}\n    </div>\n  </div>\n\n  <style>\n    #faq-block { margin: 1rem 0; }\n    #faq-toggle {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      background: none;\n      border: none;\n      font-size: 1rem;\n      font-weight: 600;\n      cursor: pointer;\n      padding: 0;\n    }\n    #faq-toggle svg { transition: transform 0.2s; }\n    #faq-toggle[aria-expanded=\"true\"] svg { transform: rotate(180deg); }\n    #faq-content { margin-top: 12px; }\n  </style>\n\n  <script>\n    document.getElementById('faq-toggle').addEventListener('click', function () {\n      var expanded = this.getAttribute('aria-expanded') === 'true';\n      var content = document.getElementById('faq-content');\n      this.setAttribute('aria-expanded', String(!expanded));\n      content.hidden = expanded;\n    });\n  </script>\n{% endif %}"
          }
