{{ 'section-imperial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign img = section.settings.image_url
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign img_alt = section.settings.image_alt | default: section.settings.heading
-%}

<div class="imperial-hero imperial-hero--{{ section.settings.height }} color-{{ section.settings.color_scheme }}" style="--imp-overlay: {{ overlay }};">
  {%- if img != blank -%}
    <div class="imperial-hero__media">
      <img
        src="{{ img }}"
        alt="{{ img_alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="900"
      >
    </div>
  {%- endif -%}
  <div class="imperial-hero__inner page-width">
    <div class="imperial-hero__content imperial-hero__content--{{ section.settings.text_alignment }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="imperial-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="imperial-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="imperial-hero__text rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
      <div class="imperial-hero__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: '#' }}" class="button button--primary">{{ section.settings.button_label_1 }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '#' }}" class="button button--secondary imperial-hero__button-alt">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero-imperial.name",
  "tag": "section",
  "class": "section imperial-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "image_url",
      "label": "t:sections.hero-imperial.settings.image_url.label",
      "info": "t:sections.hero-imperial.settings.image_url.info"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.hero-imperial.settings.image_alt.label",
      "info": "t:sections.hero-imperial.settings.image_alt.info"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero-imperial.settings.height.label",
      "options": [
        { "value": "small", "label": "t:sections.hero-imperial.settings.height.options__1.label" },
        { "value": "medium", "label": "t:sections.hero-imperial.settings.height.options__2.label" },
        { "value": "large", "label": "t:sections.hero-imperial.settings.height.options__3.label" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "t:sections.hero-imperial.settings.overlay_opacity.label",
      "default": 45
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.hero-imperial.settings.text_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.hero-imperial.settings.text_alignment.options__1.label" },
        { "value": "center", "label": "t:sections.hero-imperial.settings.text_alignment.options__2.label" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.hero-imperial.settings.color_scheme.label",
      "default": "scheme-3",
      "options": [
        { "value": "scheme-1", "label": "t:sections.hero-imperial.settings.color_scheme.options__1.label" },
        { "value": "scheme-3", "label": "t:sections.hero-imperial.settings.color_scheme.options__2.label" },
        { "value": "scheme-4", "label": "t:sections.hero-imperial.settings.color_scheme.options__3.label" },
        { "value": "scheme-5", "label": "t:sections.hero-imperial.settings.color_scheme.options__4.label" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero-imperial.settings.eyebrow.label",
      "default": "t:sections.hero-imperial.settings.eyebrow.default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero-imperial.settings.heading.label",
      "default": "t:sections.hero-imperial.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.hero-imperial.settings.subheading.label",
      "default": "t:sections.hero-imperial.settings.subheading.default"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "t:sections.hero-imperial.settings.button_label_1.label",
      "default": "t:sections.hero-imperial.settings.button_label_1.default"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "t:sections.hero-imperial.settings.button_link_1.label"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.hero-imperial.settings.button_label_2.label",
      "default": "t:sections.hero-imperial.settings.button_label_2.default"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.hero-imperial.settings.button_link_2.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-imperial.presets.name"
    }
  ]
}
{% endschema %}
