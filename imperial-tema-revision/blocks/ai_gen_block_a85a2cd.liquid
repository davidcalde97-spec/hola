{% doc %}
  @prompt
    Section for social proof with the follow text: ⭐ 4.8/5 clientes felices  •  +1,000 pedidos entregados  •  Certificación Cámara de Joyería
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-proof-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-social-proof__container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
  }

  .ai-social-proof__content-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    letter-spacing: {{ block.settings.letter_spacing }}%;
  }

  .ai-social-proof__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .ai-social-proof__separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.font_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-social-proof__content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.85 }}px;
      gap: {{ block.settings.item_spacing | times: 0.7 }}px;
    }

    .ai-social-proof__separator-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.85 }}px;
    }

    .ai-social-proof__container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }
  }
{% endstyle %}

<social-proof-{{ ai_gen_id }} class="ai-social-proof-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-proof__container-{{ ai_gen_id }}">
    <div class="ai-social-proof__content-{{ ai_gen_id }}">
      {% if block.settings.item_1_text != blank %}
        <span class="ai-social-proof__item-{{ ai_gen_id }}">{{ block.settings.item_1_text }}</span>
      {% endif %}

      {% if block.settings.item_2_text != blank %}
        <span class="ai-social-proof__separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-social-proof__item-{{ ai_gen_id }}">{{ block.settings.item_2_text }}</span>
      {% endif %}

      {% if block.settings.item_3_text != blank %}
        <span class="ai-social-proof__separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-social-proof__item-{{ ai_gen_id }}">{{ block.settings.item_3_text }}</span>
      {% endif %}
    </div>
  </div>
</social-proof-{{ ai_gen_id }}>

<script>
  (function() {
    class SocialProof{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('social-proof-{{ ai_gen_id }}', SocialProof{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Social proof",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "item_1_text",
      "label": "First item",
      "default": "⭐ 4.8/5 clientes felices"
    },
    {
      "type": "inline_richtext",
      "id": "item_2_text",
      "label": "Second item",
      "default": "+1,000 pedidos entregados"
    },
    {
      "type": "inline_richtext",
      "id": "item_3_text",
      "label": "Third item",
      "default": "Certificación Cámara de Joyería"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "•"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Font",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -5,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2a3871"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#d9bf55"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator",
      "default": "#d9bf55"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Social proof"
    }
  ]
}
{% endschema %}