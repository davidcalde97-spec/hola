{% doc %}
  @prompt
    Create a premium Icon Section for a Shopify store with a clean and modern design.
    
    Requirements:
    
    * White background (#FFFFFF).
    * Soft light blue accents (#DCEEFF or similar).
    * Responsive design for desktop, tablet, and mobile.
    * Icons displayed above the text.
    * 4 columns on desktop, 2 columns on tablet, and 1 column on mobile.
    * Subtle hover animation on icons and cards.
    * Rounded corners and elegant spacing.
    * Follow a premium e-commerce aesthetic suitable for jewelry, luxury accessories, and high-end products.
    
    Default icon blocks:
    
    1. High-Quality Materials
    
       * Icon: Diamond or Gem
       * Text: "Materiales de alta calidad"
    
    2. Secure Shopping
    
       * Icon: Shield with checkmark or Lock
       * Text: "Compra segura"
    
    3. Nationwide Shipping
    
       * Icon: Delivery Truck or Package
       * Text: "Envíos a todo México"
    
    4. Happy Customers
    
       * Icon: Users, Heart, or Star
       * Text: "Clientes satisfechos"
    
    Customization Requirements:
    
    * Allow merchants to edit the title and description of each block.
    * Allow merchants to upload their own SVG, PNG, or image icon.
    * Allow merchants to choose icon size.
    * Allow merchants to add, remove, or reorder icon blocks.
    * Allow merchants to customize text color.
    * Allow merchants to customize background color.
    * Allow merchants to adjust spacing and padding.
    * Support up to 12 icon blocks.
    * Include schema settings for full Shopify Theme Editor customization.
    
    The section should look premium, clean, trustworthy, and conversion-focused while maintaining excellent performance and accessibility.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-feature-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-align: center;
  }

  .ai-icon-feature-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow_size }}px {{ block.settings.hover_shadow_size | times: 2 }}px rgba(0, 0, 0, {{ block.settings.hover_shadow_opacity }});
  }

  .ai-icon-feature__icon-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    transition: transform 0.3s ease;
  }

  .ai-icon-feature-{{ ai_gen_id }}:hover .ai-icon-feature__icon-wrapper-{{ ai_gen_id }} {
    transform: scale({{ block.settings.icon_hover_scale }});
  }

  .ai-icon-feature__icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-icon-feature__icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-icon-feature__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.3;
  }

  .ai-icon-feature__description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-style: {{ block.settings.description_font.style }};
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-icon-feature__icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-icon-feature__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-icon-feature__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<icon-feature-{{ ai_gen_id }} class="ai-icon-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-feature__icon-wrapper-{{ ai_gen_id }}">
    {% if block.settings.icon_image %}
      <img
        src="{{ block.settings.icon_image | image_url: width: 200 }}"
        alt="{{ block.settings.icon_image.alt | default: block.settings.title | escape }}"
        loading="lazy"
        width="200"
        height="200"
      >
    {% else %}
      {% case block.settings.default_icon %}
        {% when 'diamond' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.7 10.3a2.41 2.41 0 0 0 0 3.41l7.59 7.59a2.41 2.41 0 0 0 3.41 0l7.59-7.59a2.41 2.41 0 0 0 0-3.41l-7.59-7.59a2.41 2.41 0 0 0-3.41 0Z"/>
          </svg>
        {% when 'shield' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        {% when 'truck' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
            <path d="M15 18H9"/>
            <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
            <circle cx="17" cy="18" r="2"/>
            <circle cx="7" cy="18" r="2"/>
          </svg>
        {% when 'heart' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
          </svg>
        {% when 'star' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        {% when 'users' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        {% when 'lock' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        {% when 'package' %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m7.5 4.27 9 5.15"/>
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
            <path d="m3.3 7 8.7 5 8.7-5"/>
            <path d="M12 22V12"/>
          </svg>
      {% endcase %}
    {% endif %}
  </div>

  {% if block.settings.title != blank %}
    <h3 class="ai-icon-feature__title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
  {% endif %}

  {% if block.settings.description != blank %}
    <div class="ai-icon-feature__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
  {% endif %}
</icon-feature-{{ ai_gen_id }}>

<script>
  (function() {
    class IconFeature{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setAttribute('role', 'article');
      }
    }

    customElements.define('icon-feature-{{ ai_gen_id }}', IconFeature{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Icon feature",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Custom icon image"
    },
    {
      "type": "select",
      "id": "default_icon",
      "label": "Default icon",
      "options": [
        { "value": "diamond", "label": "Diamond" },
        { "value": "shield", "label": "Shield" },
        { "value": "lock", "label": "Lock" },
        { "value": "truck", "label": "Truck" },
        { "value": "package", "label": "Package" },
        { "value": "heart", "label": "Heart" },
        { "value": "star", "label": "Star" },
        { "value": "users", "label": "Users" }
      ],
      "default": "diamond"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#2a3871"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Space below icon",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Materiales de alta calidad"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Title font",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Space below title",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#2a3871"
    },
    {
      "type": "font_picker",
      "id": "description_font",
      "label": "Description font",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#2a3871"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Background",
      "default": "#DCEEFF"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Hover effects"
    },
    {
      "type": "range",
      "id": "hover_lift",
      "label": "Lift on hover",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "hover_shadow_size",
      "label": "Shadow size",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "hover_shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.1
    },
    {
      "type": "range",
      "id": "icon_hover_scale",
      "label": "Icon scale on hover",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    }
  ],
  "presets": [
    {
      "name": "Icon feature"
    }
  ]
}
{% endschema %}
