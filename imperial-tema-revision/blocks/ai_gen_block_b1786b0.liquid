{% doc %}
  @prompt
    Create a minimal benefits slider section.
    
    Goal:
    Reinforce trust without breaking the premium aesthetic.
    
    Content:
    - Materiales de alta calidad  
    - Compra segura  
    - Envíos a todo México  
    - Diseños atemporales  
    
    Mobile:
    - Horizontal scroll
    - Small elegant icons
    - Light typography
    
    Design:
    - Minimal
    - Subtle
    - High spacing
    
    Rules:
    - Avoid bold colors
    - Keep it refined
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-slider-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.vertical_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-benefits-slider__container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-benefits-slider__wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-benefits-slider__wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-benefits-slider__item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    text-align: center;
    min-width: {{ block.settings.item_min_width }}px;
  }

  .ai-benefits-slider__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-benefits-slider__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-benefits-slider__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.text_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {{ block.settings.text_transform }};
    line-height: 1.4;
    opacity: {{ block.settings.text_opacity }};
  }

  @media screen and (min-width: 750px) {
    .ai-benefits-slider__wrapper-{{ ai_gen_id }} {
      justify-content: center;
      overflow-x: visible;
      gap: {{ block.settings.desktop_item_spacing }}px;
    }

    .ai-benefits-slider__item-{{ ai_gen_id }} {
      min-width: auto;
    }

    .ai-benefits-slider__icon-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_icon_size }}px;
      height: {{ block.settings.desktop_icon_size }}px;
    }

    .ai-benefits-slider__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.desktop_text_size }}px;
    }
  }
{% endstyle %}

<benefits-slider-{{ ai_gen_id }} class="ai-benefits-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-slider__container-{{ ai_gen_id }}">
    <div class="ai-benefits-slider__wrapper-{{ ai_gen_id }}">
      {% if block.settings.benefit_1_text != blank %}
        <div class="ai-benefits-slider__item-{{ ai_gen_id }}">
          <div class="ai-benefits-slider__icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          </div>
          <div class="ai-benefits-slider__text-{{ ai_gen_id }}">{{ block.settings.benefit_1_text }}</div>
        </div>
      {% endif %}

      {% if block.settings.benefit_2_text != blank %}
        <div class="ai-benefits-slider__item-{{ ai_gen_id }}">
          <div class="ai-benefits-slider__icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <div class="ai-benefits-slider__text-{{ ai_gen_id }}">{{ block.settings.benefit_2_text }}</div>
        </div>
      {% endif %}

      {% if block.settings.benefit_3_text != blank %}
        <div class="ai-benefits-slider__item-{{ ai_gen_id }}">
          <div class="ai-benefits-slider__icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <div class="ai-benefits-slider__text-{{ ai_gen_id }}">{{ block.settings.benefit_3_text }}</div>
        </div>
      {% endif %}

      {% if block.settings.benefit_4_text != blank %}
        <div class="ai-benefits-slider__item-{{ ai_gen_id }}">
          <div class="ai-benefits-slider__icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="ai-benefits-slider__text-{{ ai_gen_id }}">{{ block.settings.benefit_4_text }}</div>
        </div>
      {% endif %}
    </div>
  </div>
</benefits-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BenefitsSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.style.display = 'block';
      }
    }

    customElements.define('benefits-slider-{{ ai_gen_id }}', BenefitsSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Benefits slider",
  "settings": [
    {
      "type": "header",
      "content": "Benefits"
    },
    {
      "type": "text",
      "id": "benefit_1_text",
      "label": "Benefit 1",
      "default": "Materiales de alta calidad"
    },
    {
      "type": "text",
      "id": "benefit_2_text",
      "label": "Benefit 2",
      "default": "Compra segura"
    },
    {
      "type": "text",
      "id": "benefit_3_text",
      "label": "Benefit 3",
      "default": "Envíos a todo México"
    },
    {
      "type": "text",
      "id": "benefit_4_text",
      "label": "Benefit 4",
      "default": "Diseños atemporales"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Mobile item spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_item_spacing",
      "label": "Desktop item spacing",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "item_min_width",
      "label": "Mobile item min width",
      "min": 100,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Mobile icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_icon_size",
      "label": "Desktop icon size",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_stroke_width",
      "label": "Icon stroke width",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.5
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#2a3871"
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Icon to text spacing",
      "min": 6,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Mobile text size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "label": "Desktop text size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2a3871"
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "text_opacity",
      "label": "Text opacity",
      "min": 0.5,
      "max": 1,
      "step": 0.1,
      "default": 0.8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Benefits slider"
    }
  ]
}
{% endschema %}
