{% doc %}
  @prompt
    Create a premium Shopify Icon Section for a jewelry brand with a clean luxury design.
    
    Layout Requirements:
    
    * White background (#FFFFFF).
    * Light blue accent color (#DCEEFF).
    * Display all icon blocks in a single horizontal row on desktop.
    * Each block should have:
    
      * Icon centered at the top.
      * Text centered below the icon.
    * Equal spacing between all blocks.
    * Modern, elegant, and minimalist design.
    * Suitable for luxury jewelry and premium accessories.
    
    Default icon blocks:
    
    1. Diamond Icon
       Text: "Materiales de alta calidad"
    
    2. Shield Check Icon
       Text: "Compra segura"
    
    3. Delivery Truck Icon
       Text: "Envíos a todo México"
    
    4. Star or Users Icon
       Text: "Clientes satisfechos"
    
    Responsive Behavior:
    
    * Desktop: 4 columns in one horizontal row.
    * Tablet: 2 columns per row.
    * Mobile: 2 columns per row or swipeable carousel.
    * Icons and text must remain centered.
    
    Customization Settings:
    
    * Allow merchants to upload custom SVG, PNG, or image icons.
    * Allow merchants to change all text.
    * Allow merchants to add, remove, and reorder blocks.
    * Allow icon size adjustment.
    * Allow text size adjustment.
    * Allow color customization.
    * Allow spacing and padding customization.
    * Support up to 12 icon blocks.
    * Full Shopify Theme Editor schema support.
    
    Design Style:
    
    * Premium luxury appearance.
    * Subtle hover effect.
    * Clean typography.
    * Balanced spacing.
    * Optimized for conversion and trust-building.
    * Similar to high-end jewelry and luxury fashion e-commerce stores.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-feature-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-icon-feature-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-icon-feature-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-icon-feature-content-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow }}px {{ block.settings.hover_shadow | times: 2 }}px rgba(0, 0, 0, 0.08);
  }

  .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_text_spacing }}px;
    flex-shrink: 0;
  }

  .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: {{ block.settings.icon_stroke_width }};
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-icon-feature-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    letter-spacing: 0.02em;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }

    .ai-icon-feature-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.95 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-icon-feature-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
      margin-bottom: {{ block.settings.icon_text_spacing | times: 0.8 }}px;
    }

    .ai-icon-feature-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-icon-feature-content-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-icon-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-feature-container-{{ ai_gen_id }}">
    <div class="ai-icon-feature-content-{{ ai_gen_id }}">
      <div class="ai-icon-feature-icon-wrapper-{{ ai_gen_id }}">
        {% if block.settings.custom_icon != blank %}
          <img
            src="{{ block.settings.custom_icon | image_url: width: 200 }}"
            alt="{{ block.settings.icon_text | escape }}"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          {% case block.settings.icon_type %}
            {% when 'diamond' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M6 3h12l4 6-10 12L2 9l4-6z"/>
                <path d="M6 3l6 6 6-6"/>
                <path d="M2 9h20"/>
                <path d="M12 21L6 9"/>
                <path d="M12 21l6-12"/>
              </svg>
            {% when 'shield' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            {% when 'truck' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <rect x="1" y="3" width="15" height="13"/>
                <path d="M16 8h4l3 3v5h-7V8z"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
            {% when 'star' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% when 'users' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            {% when 'heart' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            {% when 'gift' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M20 12v10H4V12"/>
                <rect x="2" y="7" width="20" height="5"/>
                <path d="M12 22V7"/>
                <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
                <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
              </svg>
            {% when 'award' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="7"/>
                <path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/>
              </svg>
          {% endcase %}
        {% endif %}
      </div>
      {% if block.settings.icon_text != blank %}
        <p class="ai-icon-feature-text-{{ ai_gen_id }}">{{ block.settings.icon_text }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon feature",
  "tag": null,
  "class": "ai-icon-feature-block",
  "settings": [
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon type",
      "options": [
        {
          "value": "diamond",
          "label": "Diamond"
        },
        {
          "value": "shield",
          "label": "Shield check"
        },
        {
          "value": "truck",
          "label": "Delivery truck"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "users",
          "label": "Users"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "gift",
          "label": "Gift"
        },
        {
          "value": "award",
          "label": "Award"
        }
      ],
      "default": "diamond"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Overrides icon type if uploaded"
    },
    {
      "type": "text",
      "id": "icon_text",
      "label": "Text",
      "default": "Materiales de alta calidad"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#2a3871"
    },
    {
      "type": "range",
      "id": "icon_stroke_width",
      "label": "Icon stroke width",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "icon_text_spacing",
      "label": "Space between icon and text",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Font",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2a3871"
    },
    {
      "type": "header",
      "content": "Item style"
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Item padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "item_background_color",
      "label": "Item background",
      "default": "#DCEEFF"
    },
    {
      "type": "range",
      "id": "item_border_radius",
      "label": "Item border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Hover effect"
    },
    {
      "type": "range",
      "id": "hover_lift",
      "label": "Hover lift",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "hover_shadow",
      "label": "Hover shadow",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Icon feature"
    }
  ]
}
{% endschema %}
