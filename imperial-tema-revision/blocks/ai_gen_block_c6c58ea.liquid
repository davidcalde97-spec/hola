{% doc %}
  @prompt
    Create a minimal trust section.
    
    Title:
    Compra con confianza
    
    Items:
    - Pagos seguros  
    - Envíos confiables  
    - Calidad garantizada  
    
    Design:
    - Small icons
    - Lots of spacing
    
    Rules:
    - Keep it subtle
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.vertical_spacing }}px 0;
  }

  .ai-trust-section__title-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    opacity: {{ block.settings.text_opacity }};
    letter-spacing: 0.05em;
  }

  .ai-trust-section__items-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-trust-section__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    text-align: center;
  }

  .ai-trust-section__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    opacity: {{ block.settings.icon_opacity }};
  }

  .ai-trust-section__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    opacity: {{ block.settings.text_opacity }};
    letter-spacing: 0.03em;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-section__items-{{ ai_gen_id }} {
      gap: {{ block.settings.item_spacing | times: 0.7 }}px;
    }

    .ai-trust-section__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-trust-section__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-trust-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-trust-section__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  <div class="ai-trust-section__items-{{ ai_gen_id }}">
    {% if block.settings.show_item_1 %}
      <div class="ai-trust-section__item-{{ ai_gen_id }}">
        <div class="ai-trust-section__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="8" width="18" height="13" rx="2"></rect>
            <path d="M3 10h18"></path>
            <path d="M7 15h.01"></path>
            <path d="M11 15h2"></path>
          </svg>
        </div>
        <div class="ai-trust-section__text-{{ ai_gen_id }}">{{ block.settings.item_1_text }}</div>
      </div>
    {% endif %}

    {% if block.settings.show_item_2 %}
      <div class="ai-trust-section__item-{{ ai_gen_id }}">
        <div class="ai-trust-section__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div class="ai-trust-section__text-{{ ai_gen_id }}">{{ block.settings.item_2_text }}</div>
      </div>
    {% endif %}

    {% if block.settings.show_item_3 %}
      <div class="ai-trust-section__item-{{ ai_gen_id }}">
        <div class="ai-trust-section__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
        </div>
        <div class="ai-trust-section__text-{{ ai_gen_id }}">{{ block.settings.item_3_text }}</div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Trust section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Compra con confianza"
    },
    {
      "type": "checkbox",
      "id": "show_item_1",
      "label": "Show item 1",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "item_1_text",
      "label": "Item 1 text",
      "default": "Pagos seguros"
    },
    {
      "type": "checkbox",
      "id": "show_item_2",
      "label": "Show item 2",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "item_2_text",
      "label": "Item 2 text",
      "default": "Envíos confiables"
    },
    {
      "type": "checkbox",
      "id": "show_item_3",
      "label": "Show item 3",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "item_3_text",
      "label": "Item 3 text",
      "default": "Calidad garantizada"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Vertical spacing",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Space between items",
      "min": 30,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Title bottom spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Icon to text spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2a3871"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#2a3871"
    },
    {
      "type": "range",
      "id": "text_opacity",
      "label": "Text opacity",
      "min": 0.3,
      "max": 1,
      "step": 0.1,
      "default": 0.6
    },
    {
      "type": "range",
      "id": "icon_opacity",
      "label": "Icon opacity",
      "min": 0.3,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    }
  ],
  "presets": [
    {
      "name": "Trust section"
    }
  ]
}
{% endschema %}