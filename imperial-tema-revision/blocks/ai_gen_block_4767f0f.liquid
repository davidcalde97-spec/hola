      "type": "checkbox",
      "id": "item_2_enabled",
      "label": "Mostrar material 2",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "item_2_image",
      "label": "Imagen"
    },
    {
      "type": "inline_richtext",
      "id": "item_2_title",
      "label": "Título",
      "default": "Plata"
    },
    {
      "type": "richtext",
      "id": "item_2_text",
      "label": "Texto",
      "default": "<p>Plata .925 de ley con acabados que resisten el paso del tiempo.</p>"
    },
    {
      "type": "header",
      "content": "Material 3"
    },
    {
      "type": "checkbox",
      "id": "item_3_enabled",
      "label": "Mostrar material 3",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "item_3_image",
      "label": "Imagen"
    },
    {
      "type": "inline_richtext",
      "id": "item_3_title",
      "label": "Título",
      "default": "Acabados premium"
    },
    {
      "type": "richtext",
      "id": "item_3_text",
      "label": "Texto",
      "default": "<p>Técnicas artesanales que garantizan piezas únicas y duraderas.</p>"
    }
  ],
  "presets": [
    {
      "name": "Materiales editoriales"
    }
