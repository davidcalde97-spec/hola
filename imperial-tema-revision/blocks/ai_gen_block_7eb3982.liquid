    {
      "type": "range",
      "id": "text_letter_spacing",
      "label": "Espaciado de letras",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "Feature icons"
    }
  ]
}
{% endschema %}
