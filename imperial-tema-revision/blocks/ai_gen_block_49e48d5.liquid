{% doc %}
  @prompt
    Create a featured collection with mobile slider and quick add.
    
    Title:
    Los más elegidos
    
    Mobile:
    - Horizontal scroll (1.2 products)
    - Clean product cards
    
    IMPORTANT:
    Use safe Liquid:
    
    {% assign products_to_show = section.settings.products_to_show | plus: 0 %}
    
    Product Card:
    - Image
    - Title
    - Price
    - Minimal badges
    
    Quick Add:
    Simple add to cart button (no clutter)
    
    Design:
    - Clean
    - No heavy borders
    - Premium spacing
    
    Rules:
    - Avoid overcrowding
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign products_to_show = block.settings.products_to_show | plus: 0 %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-featured-collection__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-collection__header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-featured-collection__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ai-featured-collection__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-featured-collection__product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    background: {{ block.settings.card_background }};
  }

  .ai-featured-collection__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-featured-collection__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-featured-collection__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .ai-featured-collection__info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-featured-collection__title-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.3;
  }

  .ai-featured-collection__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.text_color }};
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .ai-featured-collection__price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .ai-featured-collection__price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_color }};
  }

  .ai-featured-collection__quick-add-{{ ai_gen_id }} {
    margin-top: auto;
    padding-top: {{ block.settings.content_spacing }}px;
  }

  .ai-featured-collection__add-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 20px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .ai-featured-collection__add-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
  }

  .ai-featured-collection__add-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: {{ block.settings.mobile_gap }}px;
      padding-bottom: 10px;
      scrollbar-width: none;
    }

    .ai-featured-collection__grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-featured-collection__product-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_card_width }}%;
      scroll-snap-align: start;
    }

    .ai-featured-collection__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-featured-collection__product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.9 }}px;
    }

    .ai-featured-collection__price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }}
  class="ai-featured-collection-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-featured-collection__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <div class="ai-featured-collection__header-{{ ai_gen_id }}">
        <h2 class="ai-featured-collection__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="ai-featured-collection__grid-{{ ai_gen_id }}">
      {% if block.settings.collection != blank %}
        {% for product in block.settings.collection.products limit: products_to_show %}
          <div class="ai-featured-collection__product-card-{{ ai_gen_id }}">
            <div class="ai-featured-collection__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-featured-collection__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-featured-collection__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if product.compare_at_price > product.price and block.settings.show_sale_badge %}
                <div class="ai-featured-collection__badge-{{ ai_gen_id }}">
                  {% if block.settings.badge_type == 'percentage' %}
                    {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                    -{{ discount }}%
                  {% else %}
                    {{ 'product.general.on_sale_badge' | t }}
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <div class="ai-featured-collection__info-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-featured-collection__title-link-{{ ai_gen_id }}">
                <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              </a>

              <div class="ai-featured-collection__price-{{ ai_gen_id }}">
                {% if product.compare_at_price > product.price %}
                  <span class="ai-featured-collection__price-compare-{{ ai_gen_id }}">
                    {{ product.compare_at_price | money }}
                  </span>
                  <span class="ai-featured-collection__price-sale-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                {% else %}
                  <span>{{ product.price | money }}</span>
                {% endif %}
              </div>

              {% if block.settings.show_quick_add %}
                <div class="ai-featured-collection__quick-add-{{ ai_gen_id }}">
                  {% if product.available %}
                    <button
                      type="button"
                      class="ai-featured-collection__add-button-{{ ai_gen_id }}"
                      data-product-id="{{ product.id }}"
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    >
                      {{ block.settings.button_text }}
                    </button>
                  {% else %}
                    <button
                      type="button"
                      class="ai-featured-collection__add-button-{{ ai_gen_id }}"
                      disabled
                    >
                      {{ 'product.general.sold_out_button' | t }}
                    </button>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..products_to_show) %}
          <div class="ai-featured-collection__product-card-{{ ai_gen_id }}">
            <div class="ai-featured-collection__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-featured-collection__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-featured-collection__info-{{ ai_gen_id }}">
              <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">Producto de ejemplo</h3>
              <div class="ai-featured-collection__price-{{ ai_gen_id }}">
                <span>$99.00</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupQuickAdd();
      }

      setupQuickAdd() {
        const buttons = this.querySelectorAll('.ai-featured-collection__add-button-{{ ai_gen_id }}');

        buttons.forEach(button => {
          button.addEventListener('click', async (e) => {
            const variantId = button.dataset.variantId;

            if (!variantId) return;

            button.disabled = true;
            const originalText = button.textContent;
            button.textContent = 'Agregando...';

            try {
              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  items: [{
                    id: variantId,
                    quantity: 1
                  }]
                })
              });

              if (response.ok) {
                button.textContent = '¡Agregado!';

                const cartDrawer = document.querySelector('cart-drawer');
                if (cartDrawer) {
                  cartDrawer.open();
                }

                window.dispatchEvent(new CustomEvent('cart:refresh'));

                setTimeout(() => {
                  button.textContent = originalText;
                  button.disabled = false;
                }, 2000);
              } else {
                throw new Error('Error al agregar al carrito');
              }
            } catch (error) {
              button.textContent = 'Error';
              setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2000);
            }
          });
        });
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

