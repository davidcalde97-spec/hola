","separate_section_with_border":true,"hide_product_information":false,"stack_products":false,"products_per_row_mobile":"2","products_per_row_desktop":4,"horizontal_spacing_factor":0.2,"vertical_spacing_factor":2,"header_alignment":"center","heading_style":"h2","subheading":"NUESTRAS COLECCIONES","hide_collection_title":false}},"featured_collections_GYrtJz":{"type":"featured-collections","blocks":{"collection_NgJp6C":{"type":"collection","settings":{"collection":"oro-nuevo","products_count":8,"title":"Oro","link_url":"","link_text":"Comprar"}},"collection_pG6TTC":{"type":"collection","settings":{"collection":"plata-nuevo","products_count":8,"title":"Plata","link_url":"","link_text":"Ver todos"}}},"block_order":["collection_NgJp6C","collection_pG6TTC"],"name":"t:sections.featured_collections.presets.featured_collections.name","settings":{"color_scheme":"scheme-bccf5a9c-3212-45a7-a88e-739fd0fda227","separate_section_with_border":true,"hide_product_information":false,"stack_products":false,"products_per_row_mobile":"2","products_per_row_desktop":4,"horizontal_spacing_factor":1,"vertical_spacing_factor":1,"header_alignment":"center","heading_style":"h2","subheading":"Explora nuestros materiales","hide_collection_title":false}},"image-with-text-scroll":{"type":"images-with-text-scroll","blocks":{"item-1":{"type":"image_with_text","settings":{"image":"shopify://shop_images/cldy-anillos-78312-12.jpg","subheading":"","title":"Anillos","content":"<p>Nuestros <strong>anillos </strong>son fabricados con la más avanzada tecnología de <strong>impresión 3D</strong>, montaje de piedra en cera y <strong>fundicion de presición </strong><em>(lost wax casting)</em>, un proceso que elimina imperfecciones y garantiza precisión absoluta en cada detalle. Al mismo tiempo, cada pieza pasa por el <strong>control de calidad de nuestros joyeros artesanos</strong>, quienes aportan su experiencia y sensibilidad para asegurar un acabado impecable que combina <strong>innovación, perfección técnica y tradición artesanal</strong>.<br/><br/></p>","link_text":"","link_url":"","link_style":"solid"}},"item-2":{"type":"image_with_text","settings":{"image":"shopify://shop_images/cldy-aretes-79864-02.jpg","subheading":"","title":"Aretes","content":"<p>Nuestras <strong>arracadas </strong>destacan por su <strong>brillo intenso, color definido, diamantado preciso y peso único </strong>que se siente sólido y cómodo a la vez. Están fabricadas por la <strong>mejor casa de joyería de tubo en México </strong>,<strong>miembro permanente del Grupo de Calidad de la Cámara de Joyería de Jalisco</strong>, lo que garantiza <strong>acabados superiores, consistencia y larga durabilidad</strong>. Ideales para uso diario u ocasiones especiales, son una elección segura para quienes buscan <strong>impacto visual, calidad y tradición </strong>en una sola pieza.<br/><br/></p>","link_text":"","link_url":"","link_style":"solid"}},"item-3":{"type":"image_with_text","settings":{"image":"shopify://shop_images/cldy-collares-78356-00.jpg","subheading":"","title":"Collares","content":"<p>Nuestras <strong>cadenas  </strong>son sinónimo de elegancia, tradición y excelencia. Cada pieza está elaborada en un <strong>100% de oro auténtico</strong>, proveniente exclusivamente de las mejores fábricas de <strong>Vicenza, Arezzo y Bassano del Grappa</strong>, regiones italianas reconocidas a nivel mundial por su maestría en la producción de joyería de oro y plata.<br/><br/></p>","link_text":"","link_url":"","link_style":"solid"}},"image_with_text_NNfyc8":{"type":"image_with_text","settings":{"image":"shopify://shop_images/cldy-dijes-78218-02.jpg","subheading":"","title":"Dijes","content":"<p>Nuestros dijes son una fusión perfecta entre fe, arte y excelencia.<br/><br/>Cada pieza representa mucho más que un accesorio: es un símbolo de espiritualidad, devoción y protección. Elaborados en 100% oro auténtico, nuestros dijes provienen de las mejores talleres de Italia y Turquía, reconocidas mundialmente por su maestría en la joyería fina, así como de fábricas nacionales que destacan por su innovación y precisión.</p><p>El resultado son piezas con un brillo intenso, color definido, diamantado preciso y un peso equilibrado que se siente sólido y cómodo a la vez.<br/></p>","link_text":"","link_url":"","link_style":"solid"}},"image_with_text_HcXaFy":{"type":"image_with_text","settings":{"image":"shopify://shop_images/cldy-promo-79626-05.jpg","subheading":"","title":"Pulseras","content":"<p>Nuestras <strong>pulseras </strong>representan lo mejor del gusto europeo, elaboradas en los mejores talleres de europa reconocidos por su tradición joyera. Cada pulsera combina <strong>brillo, elegancia y durabilidad</strong>, con un diseño atemporal. Una joya ideal tanto para <strong>uso diario como para ocasiones especiales</strong>.<br/><br/><br/><br/></p>","link_text":"","link_url":"","link_style":"solid"}}},"block_order":["item-1","item-2","item-3","image_with_text_NNfyc8","image_with_text_HcXaFy"],"settings":{"color_scheme":"scheme-845c1987-e02f-481a-a2f6-374bb7250aff","image_position":"start","text_alignment":"center","heading_tag":"h3","overlay_color":"#000000","overlay_opacity":0}},"multiple-media-with-text":{"type":"multiple-media-with-text","blocks":{"image-1":{"type":"image","settings":{"image":"shopify://shop_images/Logo_Iniciales_Cuadrado.jpg","rotation":0}},"image-2":{"type":"image","settings":{"image":"shopify://shop_images/cldy-brand-79864-03.jpg","rotation":0}}},"block_order":["image-1","image-2"],"settings":{"color_scheme":"scheme-3eaa1a65-f2e9-4952-9b80-12b9f430548c","reveal_on_scroll":true,"separate_section_with_border":true,"media_position_desktop":"before_text","media_position_mobile":"before_text","media_layout":"overlap","media_alignment":"end","media_alignment_offset":80,"media_mobile_alignment_offset":40,"text_alignment":"center","subheading":"","title":"Imperial Jewelry","heading_style":"h3","content":"<p>Nuestra joyería ofrece piezas con la más alta <strong>calidad</strong>, tanto en productos <strong>importados </strong>como en nuestras <strong>creaciones mexicanas</strong>.<br/><br/></p>","button_1_text":"","button_1_link":"","button_1_style":"solid","button_2_text":"","button_2_link":"","button_2_style":"solid"}},"178070574372f0c6d3":{"type":"_blocks","blocks":{"ai_gen_block_a85a2cd_bTMrtE":{"type":"ai_gen_block_a85a2cd","settings":{"item_1_text":"⭐ 4.8/5 clientes felices","item_2_text":"+1,000 pedidos entregados","item_3_text":"Certificación Cámara de Joyería","separator":"•","desktop_width_percent":100,"text_font":"serif","font_size":14,"letter_spacing":0,"item_spacing":20,"background_color":"#2a3871","text_color":"#d9bf55","separator_color":"#d9bf55","padding_vertical":20,"padding_horizontal":30,"border_radius":0},"blocks":{}}},"block_order":["ai_gen_block_a85a2cd_bTMrtE"],"settings":{"color_scheme":"","separate_section_with_border":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false}},"rich_text_8xghYJ":{"type":"rich-text","blocks":{"subheading_tNiQE4":{"type":"subheading","settings":{"text":""}},"heading_RYYEMK":{"type":"heading","settings":{"text":"También De venta en","heading_tag":"h1"}},"richtext_T8bddR":{"type":"richtext","settings":{"content":""}}},"block_order":["subheading_tNiQE4","heading_RYYEMK","richtext_T8bddR"],"name":"t:sections.rich_text.presets.rich_text.name","settings":{"color_scheme":"scheme-bccf5a9c-3212-45a7-a88e-739fd0fda227","separate_section_with_border":true,"content_width":"xs","text_position":"center","remove_vertical_spacing":true}},"text_with_icons_ehEwdn":{"type":"text-with-icons","blocks":{"item_c64T8x":{"type":"item","settings":{"icon":"picto-award-gift","custom_icon":"shopify://shop_images/mercado-libre-logo-0233EC77C6-seeklogo.com_97455e87-891b-48e0-ae29-3b212098d040.png","icon_width":64,"mobile_icon_width":64,"title":"<a href=\"https://www.mercadolibre.com.mx/tienda/imperial-jewelry\" target=\"_blank\" title=\"https://www.mercadolibre.com.mx/tienda/imperial-jewe